{
  "name": "krux",
  "version": "1.0.0",
  "description": "KRUX - Descubre rutas de escalada, registra tus ascensos y conecta con la comunidad",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "build": "bash scripts/build-www.sh",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "cap:build:ios": "npx cap build ios",
    "cap:build:android": "npx cap build android",
    "icons:generate": "cd icons/pwa && ./generate-icons.sh",
    "geojson": "bash scripts/Personal/sync-geojson.sh"
  },
  "keywords": [
    "climbing",
    "routes",
    "pwa",
    "escalada",
    "rutas"
  ],
  "author": "KRUX Team",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4"
  }
}
